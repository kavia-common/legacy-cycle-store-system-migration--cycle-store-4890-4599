{
    "name": "minimal-express-app",
    "version": "1.0.0",
    "description": "Minimal Express app with scalable structure",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "lint": "eslint .",
        "db:migrate": "sequelize db:migrate",
        "db:migrate:undo": "sequelize db:migrate:undo",
        "db:seed": "sequelize db:seed:all",
        "db:seed:undo": "sequelize db:seed:undo:all",
        "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all",
        "openapi:generate": "node generate_openapi.js"
    },
    "dependencies": {
        "cors": "2.8.5",
        "dotenv": "^16.3.1",
        "express": "4.21.2",
        "joi": "^17.13.3",
        "mysql2": "^3.11.4",
        "sequelize": "^6.37.3",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "sequelize-cli": "^6.6.2"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build"
        ],
        "ext": "js,json"
    }
}
