# Server
PORT=3000
HOST=0.0.0.0
RATE_LIMIT_MAX=300
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyclestore_db
DB_USER=cyclestore_user
DB_PASSWORD=cyclestore_password
DB_SSL=false
DB_LOGGING=false
DB_SYNC=false

# Security
JWT_SECRET=replace_with_strong_secret
# Or provide a public key for JWT verification (PEM)
JWT_PUBLIC_KEY=
DATA_ENCRYPTION_KEY=replace_with_32_char_secret

