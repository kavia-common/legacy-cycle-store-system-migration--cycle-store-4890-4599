# Data Service
PORT=3003
HOST=0.0.0.0
NODE_ENV=production

# Security
FORCE_HTTPS=false
CORS_ORIGINS=http://localhost:3000
AUDIT_ENABLED=true

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=cyclestore_db
MYSQL_USER=cyclestore
MYSQL_PASSWORD=cyclestorepass

# Optional MySQL SSL
# MYSQL_SSL_CA_PATH=/certs/ca.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true
