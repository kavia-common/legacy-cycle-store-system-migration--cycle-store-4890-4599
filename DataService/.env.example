# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database connection (MySQL)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyclestore_db
DB_USER=root
DB_PASSWORD=changeme
DB_LOGGING=false

# SSL options for DB (optional)
DB_SSL=false

# Audit
AUDIT_ENABLED=true

# OpenAPI
API_BASE_PATH=/api/v1

# Actor header used for audit logging if no auth middleware available
ACTOR_HEADER=x-actor
